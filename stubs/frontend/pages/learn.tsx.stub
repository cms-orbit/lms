import { Head, Link, router } from '@inertiajs/react';
import { useRef } from 'react';

interface LessonRow {
    id: number;
    title: string;
    locked: boolean;
}

interface SectionRow {
    title: string;
    lessons: LessonRow[];
}

interface PlayerSettings {
    disable_seek: boolean;
    disable_fastforward: boolean;
    autoplay: boolean;
    require_completion: boolean;
}

interface Props {
    course: {
        slug: string;
        title: string;
        sections: SectionRow[];
    };
    lesson: {
        id: number;
        title: string;
        type: string | null;
        content: string | null;
        video_url: string | null;
        video_provider: string | null;
    };
    player: PlayerSettings;
    completedLessonIds: number[];
    progress: number;
}

export default function Learn({ course, lesson, player, completedLessonIds, progress }: Props) {
    const isDone = completedLessonIds.includes(lesson.id);
    // Highest position the learner has legitimately reached (for fast-forward lock).
    const watchedTo = useRef(0);
    const lastTime = useRef(0);

    const nativeVideo = lesson.type === 'video' && lesson.video_url && ['mp4', 'file', 'native'].includes(lesson.video_provider ?? '');

    const onTimeUpdate = (event: React.SyntheticEvent<HTMLVideoElement>) => {
        const video = event.currentTarget;
        if (!video.seeking) {
            watchedTo.current = Math.max(watchedTo.current, video.currentTime);
            lastTime.current = video.currentTime;
        }
    };

    const onSeeking = (event: React.SyntheticEvent<HTMLVideoElement>) => {
        const video = event.currentTarget;

        if (player.disable_seek && Math.abs(video.currentTime - lastTime.current) > 0.5) {
            video.currentTime = lastTime.current;
            return;
        }

        if (player.disable_fastforward && video.currentTime > watchedTo.current + 0.5) {
            video.currentTime = watchedTo.current;
        }
    };

    const markComplete = () => {
        router.post(`/learn/lesson/${lesson.id}/complete`, {}, { preserveScroll: true });
    };

    return (
        <div className="flex min-h-screen bg-gray-50">
            <Head title={lesson.title} />

            <aside className="hidden w-72 shrink-0 border-r border-gray-200 bg-white lg:block">
                <div className="border-b border-gray-100 p-4">
                    <Link href={`/courses/${course.slug}`} className="text-sm text-indigo-600 hover:underline">
                        ← {course.title}
                    </Link>
                    <div className="mt-3 h-2 w-full rounded-full bg-gray-100">
                        <div className="h-2 rounded-full bg-indigo-600" style={{ width: `${progress}%` }} />
                    </div>
                    <p className="mt-1 text-xs text-gray-500">{progress}% complete</p>
                </div>
                <nav className="p-2">
                    {course.sections.map((section, index) => (
                        <div key={index} className="mb-3">
                            <p className="px-2 py-1 text-xs font-semibold uppercase tracking-wide text-gray-400">{section.title}</p>
                            {section.lessons.map((item) =>
                                item.locked ? (
                                    <span
                                        key={item.id}
                                        className="flex items-center gap-2 rounded px-2 py-1.5 text-sm text-gray-400"
                                        title="Locked (drip content)"
                                    >
                                        <span>🔒</span>
                                        <span className="line-clamp-1">{item.title}</span>
                                    </span>
                                ) : (
                                    <Link
                                        key={item.id}
                                        href={`/learn/${course.slug}/${item.id}`}
                                        className={`flex items-center gap-2 rounded px-2 py-1.5 text-sm ${
                                            item.id === lesson.id ? 'bg-indigo-50 text-indigo-700' : 'text-gray-700 hover:bg-gray-50'
                                        }`}
                                    >
                                        <span>{completedLessonIds.includes(item.id) ? '✓' : '○'}</span>
                                        <span className="line-clamp-1">{item.title}</span>
                                    </Link>
                                ),
                            )}
                        </div>
                    ))}
                </nav>
            </aside>

            <main className="flex-1 p-6">
                <h1 className="text-2xl font-bold text-gray-900">{lesson.title}</h1>

                <div className="mt-6">
                    {nativeVideo ? (
                        <video
                            src={lesson.video_url ?? undefined}
                            controls
                            autoPlay={player.autoplay}
                            onTimeUpdate={onTimeUpdate}
                            onSeeking={onSeeking}
                            className="aspect-video w-full rounded-xl bg-black"
                        />
                    ) : lesson.type === 'video' && lesson.video_url ? (
                        <div className="aspect-video w-full overflow-hidden rounded-xl bg-black">
                            <iframe src={lesson.video_url} title={lesson.title} className="h-full w-full" allowFullScreen />
                        </div>
                    ) : null}

                    {(player.disable_seek || player.disable_fastforward) && nativeVideo ? (
                        <p className="mt-2 text-xs text-amber-600">
                            {player.disable_seek ? 'Seeking is disabled for this lesson.' : 'Fast-forwarding past unwatched content is disabled.'}
                        </p>
                    ) : null}

                    {lesson.content ? (
                        <div className="prose mt-6 max-w-none text-gray-800" dangerouslySetInnerHTML={{ __html: lesson.content }} />
                    ) : null}
                </div>

                <button
                    type="button"
                    onClick={markComplete}
                    disabled={isDone}
                    className="mt-8 rounded-lg bg-indigo-600 px-5 py-2 font-semibold text-white transition hover:bg-indigo-700 disabled:opacity-60"
                >
                    {isDone ? 'Completed ✓' : 'Mark as complete'}
                </button>
            </main>
        </div>
    );
}
