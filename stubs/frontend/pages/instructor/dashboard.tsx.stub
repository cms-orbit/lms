import { Head, Link } from '@inertiajs/react';

interface CourseRow {
    id: number;
    slug: string;
    title: string;
    status: string | null;
    students: number;
    rating: number;
}

interface ReviewRow {
    rating: number;
    comment: string | null;
    student: string | null;
    course: string | null;
}

interface QuestionRow {
    title: string | null;
    author: string | null;
    course: string | null;
    resolved: boolean;
}

interface Stats {
    courses_count: number;
    published_count: number;
    students_count: number;
    enrollments_count: number;
    total_earnings: number;
    available_earnings: number;
    paid_earnings: number;
    courses: CourseRow[];
    recent_reviews: ReviewRow[];
    recent_questions: QuestionRow[];
}

interface Props {
    stats: Stats;
}

function Stat({ label, value }: { label: string; value: string | number }) {
    return (
        <div className="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
            <div className="text-2xl font-bold text-gray-900">{value}</div>
            <div className="mt-1 text-sm text-gray-500">{label}</div>
        </div>
    );
}

export default function InstructorDashboard({ stats }: Props) {
    return (
        <div className="mx-auto max-w-6xl px-4 py-10">
            <Head title="Instructor dashboard" />

            <h1 className="mb-8 text-3xl font-bold text-gray-900">Instructor dashboard</h1>

            <div className="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
                <Stat label="Courses" value={stats.courses_count} />
                <Stat label="Published" value={stats.published_count} />
                <Stat label="Students" value={stats.students_count} />
                <Stat label="Enrollments" value={stats.enrollments_count} />
                <Stat label="Available" value={stats.available_earnings.toFixed(2)} />
                <Stat label="Total earned" value={stats.total_earnings.toFixed(2)} />
            </div>

            <div className="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-3">
                <div className="lg:col-span-2">
                    <h2 className="mb-3 text-xl font-semibold text-gray-900">Your courses</h2>
                    <div className="overflow-hidden rounded-xl border border-gray-200 bg-white">
                        <table className="w-full text-sm">
                            <thead className="bg-gray-50 text-left text-gray-500">
                                <tr>
                                    <th className="px-4 py-2">Course</th>
                                    <th className="px-4 py-2">Status</th>
                                    <th className="px-4 py-2">Students</th>
                                    <th className="px-4 py-2">Rating</th>
                                </tr>
                            </thead>
                            <tbody className="divide-y divide-gray-100">
                                {stats.courses.map((course) => (
                                    <tr key={course.id}>
                                        <td className="px-4 py-2">
                                            <Link href={`/courses/${course.slug}`} className="text-indigo-600 hover:underline">
                                                {course.title}
                                            </Link>
                                        </td>
                                        <td className="px-4 py-2 text-gray-600">{course.status}</td>
                                        <td className="px-4 py-2 text-gray-600">{course.students}</td>
                                        <td className="px-4 py-2 text-amber-600">★ {course.rating.toFixed(1)}</td>
                                    </tr>
                                ))}
                                {stats.courses.length === 0 ? (
                                    <tr>
                                        <td colSpan={4} className="px-4 py-6 text-center text-gray-400">
                                            No courses yet.
                                        </td>
                                    </tr>
                                ) : null}
                            </tbody>
                        </table>
                    </div>
                </div>

                <div className="space-y-6">
                    <div>
                        <h2 className="mb-3 text-xl font-semibold text-gray-900">Recent reviews</h2>
                        <div className="space-y-2">
                            {stats.recent_reviews.map((review, index) => (
                                <div key={index} className="rounded-lg border border-gray-100 bg-white p-3 text-sm">
                                    <div className="text-amber-600">{'★'.repeat(review.rating)}</div>
                                    <p className="mt-1 text-gray-700">{review.comment}</p>
                                    <p className="mt-1 text-xs text-gray-400">
                                        {review.student} · {review.course}
                                    </p>
                                </div>
                            ))}
                            {stats.recent_reviews.length === 0 ? <p className="text-sm text-gray-400">No reviews yet.</p> : null}
                        </div>
                    </div>

                    <div>
                        <h2 className="mb-3 text-xl font-semibold text-gray-900">Recent questions</h2>
                        <div className="space-y-2">
                            {stats.recent_questions.map((question, index) => (
                                <div key={index} className="rounded-lg border border-gray-100 bg-white p-3 text-sm">
                                    <p className="font-medium text-gray-800">{question.title ?? 'Question'}</p>
                                    <p className="mt-1 text-xs text-gray-400">
                                        {question.author} · {question.course} · {question.resolved ? 'resolved' : 'open'}
                                    </p>
                                </div>
                            ))}
                            {stats.recent_questions.length === 0 ? <p className="text-sm text-gray-400">No questions yet.</p> : null}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    );
}
