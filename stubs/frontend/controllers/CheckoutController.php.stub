<?php

declare(strict_types=1);

namespace App\Http\Controllers\Lms;

use App\Http\Controllers\Controller;
use CmsOrbit\Lms\Models\Course;
use CmsOrbit\Lms\Services\CheckoutService;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Inertia\Inertia;
use Inertia\Response;

/**
 * Course checkout. Published scaffolding — replace the demo settlement with a
 * real payment gateway (Stripe, Toss, PayPal, …) where marked below.
 */
class CheckoutController extends Controller
{
    public function show(Request $request, Course $course): Response
    {
        abort_unless($course->isPublished(), 404);

        return Inertia::render('lms/checkout', [
            'course' => [
                'slug' => $course->slug,
                'title' => $course->title,
                'is_free' => $course->is_free,
                'price' => (float) $course->price,
                'effective_price' => $course->effectivePrice(),
                'currency' => $course->currency,
            ],
        ]);
    }

    public function store(Request $request, Course $course, CheckoutService $checkout): RedirectResponse
    {
        abort_unless($course->isPublished(), 404);

        $validated = $request->validate([
            'coupon' => ['nullable', 'string', 'max:64'],
        ]);

        $student = $request->user();

        if ($course->is_free) {
            $checkout->enrollFree($student, $course);
        } else {
            $order = $checkout->checkout($student, [$course], $validated['coupon'] ?? null);

            // ---------------------------------------------------------------
            // Payment gateway integration point.
            // In production, redirect to your gateway and call
            // $checkout->markPaid($order) from the payment webhook instead.
            // This scaffold settles the order immediately for demonstration.
            // ---------------------------------------------------------------
            $checkout->markPaid($order);
        }

        return redirect()
            ->route('lms.courses.show', $course->slug)
            ->with('message', __('You are now enrolled.'));
    }
}
