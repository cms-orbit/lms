<?php

declare(strict_types=1);

namespace App\Http\Controllers\Lms;

use App\Http\Controllers\Controller;
use CmsOrbit\Lms\Models\Course;
use CmsOrbit\Lms\Models\Enrollment;
use CmsOrbit\Lms\Models\Lesson;
use CmsOrbit\Lms\Models\LessonProgress;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Inertia\Inertia;
use Inertia\Response;

/**
 * Lesson player + progress tracking. Published scaffolding — edit freely.
 */
class LearnController extends Controller
{
    public function show(Request $request, Course $course, Lesson $lesson): Response
    {
        abort_unless((int) $lesson->course_id === (int) $course->id, 404);

        $enrollment = $this->enrollment($request, $course);
        abort_unless($enrollment !== null || $lesson->is_preview, 403);

        $course->load(['sections.lessons']);

        $completed = $enrollment
            ? $enrollment->lessonProgress()->where('completed', true)->pluck('lesson_id')->all()
            : [];

        return Inertia::render('lms/learn', [
            'course' => [
                'slug' => $course->slug,
                'title' => $course->title,
                'sections' => $course->sections->map(fn ($section) => [
                    'title' => $section->title,
                    'lessons' => $section->lessons->map(fn ($item) => [
                        'id' => $item->id,
                        'title' => $item->title,
                    ]),
                ]),
            ],
            'lesson' => [
                'id' => $lesson->id,
                'title' => $lesson->title,
                'type' => $lesson->type?->value,
                'content' => $lesson->content,
                'video_url' => $lesson->video_url,
            ],
            'completedLessonIds' => $completed,
            'progress' => $enrollment?->progress ?? 0,
        ]);
    }

    public function complete(Request $request, Lesson $lesson): RedirectResponse
    {
        $course = $lesson->course;
        $enrollment = $this->enrollment($request, $course);
        abort_if($enrollment === null, 403);

        LessonProgress::query()->updateOrCreate(
            ['enrollment_id' => $enrollment->id, 'lesson_id' => $lesson->id],
            ['completed' => true, 'completed_at' => now()],
        );

        $enrollment->recalculateProgress();

        return back();
    }

    protected function enrollment(Request $request, Course $course): ?Enrollment
    {
        $user = $request->user();

        if ($user === null) {
            return null;
        }

        return Enrollment::query()
            ->where('course_id', $course->id)
            ->where('student_id', $user->getKey())
            ->first();
    }
}
