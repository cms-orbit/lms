<?php

declare(strict_types=1);

namespace App\Http\Controllers\Lms;

use App\Http\Controllers\Controller;
use CmsOrbit\Lms\Services\InstructorDashboardService;
use Illuminate\Http\Request;
use Inertia\Inertia;
use Inertia\Response;

/**
 * Instructor dashboard (courses, students, earnings, engagement).
 * Published scaffolding — edit freely.
 */
class InstructorController extends Controller
{
    public function index(Request $request, InstructorDashboardService $stats): Response
    {
        return Inertia::render('lms/instructor/dashboard', [
            'stats' => $stats->forInstructor($request->user()),
        ]);
    }
}
